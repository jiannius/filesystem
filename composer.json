{
    "name": "jiannius/filesystem",
    "description": "Jiannius Filesystem",
    "type": "library",
    "version": "1.0.0",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "league/flysystem-aws-s3-v3": "^3.0",
        "league/glide": "^3.0",
        "symfony/http-client": "^6.0 || ^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^11.0"
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Jiannius\\Filesystem\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jiannius\\Filesystem\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "TJ",
            "email": "tj@jiannius.com"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "Jiannius\\Filesystem\\FilesystemServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
